{
  "name": "Xcerebro 2.0 — Daily Ads Feedback Loop",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * *" }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Daily 9am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AGENT_RUNTIME_URL}}/agents/ads-strategist/invoke",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$env.AGENT_RUNTIME_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"task\": \"Run yesterday's ads check. Pull Meta Ads + Google Ads performance for the past 24 hours. Identify: (1) top 3 performers, (2) bottom 3 (kill candidates), (3) CPA/ROAS by audience, (4) 1-3 specific recommendations for the next 24 hours. Brief output (under 250 words). Format for Slack readability.\",\n  \"context\": {\n    \"date\": \"{{$now.toISOString().slice(0,10)}}\",\n    \"meta_ads_account_id\": \"{{$env.META_ADS_ACCOUNT_ID}}\"\n  },\n  \"require_approval\": false\n}",
        "options": { "timeout": 180000 },
        "method": "POST"
      },
      "id": "ads-check",
      "name": "Ads Strategist Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_NOTIFICATIONS_CHANNEL_ID}}",
        "text": "=📊 *Daily Ads Brief — {{$now.format('MMM D')}}*\n\n{{$json.result}}\n\n_Recommendations require your approval before execution._",
        "otherOptions": { "mrkdwn": true }
      },
      "id": "post-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Daily 9am Trigger": {
      "main": [[{ "node": "Ads Strategist Check", "type": "main", "index": 0 }]]
    },
    "Ads Strategist Check": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Chicago", "saveDataErrorExecution": "all" },
  "tags": [{ "name": "xcerebro" }, { "name": "ads" }, { "name": "marketing" }],
  "pinData": {},
  "versionId": "1.0.0"
}

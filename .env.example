# ============================================================
# XCEREBRO 2.0 — ENVIRONMENT VARIABLES
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit your .env file to git.
# ============================================================

# ---------- LLM PROVIDER (required) ----------
# Pick ONE primary provider. CrewAI agents will use this for reasoning.
# Get keys: https://console.anthropic.com or https://platform.openai.com

ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# Default model used by Tier A leadership agents
# Recommended: claude-sonnet-4-5 or gpt-4o
DEFAULT_LLM_MODEL=claude-sonnet-4-5
DEFAULT_LLM_PROVIDER=anthropic

# ---------- MULTI-MODEL ROUTING (v2.1+) ----------
# Routes tasks to cheap models (DeepSeek) by default, escalates to Claude/GPT
# only when needed. Cuts LLM costs 70-90% for typical workloads.
# Set ROUTING_ENABLED=true to turn it on.

ROUTING_ENABLED=false
ROUTING_DEFAULT_TIER=balanced  # economy | balanced | premium
ROUTING_MAX_RETRIES=2

# DeepSeek API key — get one at https://platform.deepseek.com
# Costs ~$0.27 per 1M input tokens (vs $15 for Claude Opus = 55x cheaper)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Groq API key — optional, for ultra-fast Llama inference
# Get one at https://console.groq.com
GROQ_API_KEY=

# ---------- DATABASE (auto-set by Railway) ----------
# Railway provides these automatically when you add a Postgres service.

DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/xcerebro
REDIS_URL=redis://redis.railway.internal:6379

# ---------- N8N (set after deploying n8n template) ----------
# After Railway deploys n8n, create an API key at:
# Settings → API → Create API Key

N8N_BASE_URL=https://n8n-production-xxxx.up.railway.app
N8N_API_KEY=n8n_api_...
N8N_WEBHOOK_URL=https://n8n-production-xxxx.up.railway.app/webhook

# ---------- DIFY (set after deploying Dify template) ----------
# After Railway deploys Dify, create an API key in Dify settings.

DIFY_BASE_URL=https://dify-nginx-production-xxxx.up.railway.app
DIFY_API_KEY=app-...

# ---------- POSTIZ (set after deploying Postiz template) ----------

POSTIZ_BASE_URL=https://postiz-production-xxxx.up.railway.app
POSTIZ_API_KEY=postiz_...

# ---------- AGENT RUNTIME (this app) ----------
# Where this CrewAI runtime is reachable.
# Railway sets PORT automatically. AGENT_RUNTIME_URL is used for n8n callbacks.

PORT=8000
AGENT_RUNTIME_URL=https://crew-production-xxxx.up.railway.app
AGENT_RUNTIME_API_KEY=generate-a-random-string-here

# ---------- SLACK (for human approval inbox) ----------
# Create a Slack app: https://api.slack.com/apps
# Required: chat:write, channels:read, users:read scopes

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=  # Slack app "Signing Secret" — verifies /slack/interactions button clicks
SLACK_APPROVAL_CHANNEL_ID=C01234ABCDE
SLACK_NOTIFICATIONS_CHANNEL_ID=C01234FGHIJ

# ---------- CRM (GoHighLevel — required for sales/lead agents) ----------

GHL_API_KEY=ghl_...
GHL_LOCATION_ID=...
GHL_BASE_URL=https://services.leadconnectorhq.com

# ---------- INSTAGRAM (for DM/Comment agents) ----------
# Use ManyChat or Instagram Graph API (Business account required)

INSTAGRAM_ACCESS_TOKEN=IGQVJ...
INSTAGRAM_ACCOUNT_ID=...
MANYCHAT_API_KEY=...

# ---------- STRIPE (for CFO agent) ----------

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- SKOOL (optional — for community management) ----------
# Skool does not have a public API. The Skool agent uses scheduled scrapes.

SKOOL_GROUP_URL=https://www.skool.com/your-group
SKOOL_SESSION_COOKIE=

# ---------- GOOGLE WORKSPACE (Gmail, Calendar, Sheets) ----------
# Use OAuth2. Configure in n8n's credentials manager.

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ---------- META ADS (for Ads Strategist agent) ----------

META_ADS_ACCESS_TOKEN=EAA...
META_ADS_ACCOUNT_ID=act_...

# ---------- GITHUB (for Automation Engineer agent) ----------

GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ---------- LOGGING & OBSERVABILITY ----------

LOG_LEVEL=info
SENTRY_DSN=

# ---------- COST CONTROLS ----------
# Hard caps on LLM spend per task / per day.
# Prevents a runaway agent from racking up bills.

MAX_TOKENS_PER_TASK=4000
MAX_TASKS_PER_HOUR=120
MAX_DAILY_LLM_SPEND_USD=50

# ---------- HUMAN APPROVAL DEFAULTS ----------
# Whether to require human approval on each action category.
# Recommended: keep all to TRUE during first 2 weeks of operation.

APPROVAL_REQUIRED_FOR_DM=true
APPROVAL_REQUIRED_FOR_EMAIL=true
APPROVAL_REQUIRED_FOR_PUBLIC_POST=true
APPROVAL_REQUIRED_FOR_CRM_UPDATE=false
APPROVAL_REQUIRED_FOR_CALENDAR_BOOKING=false
APPROVAL_REQUIRED_FOR_REFUND=true
APPROVAL_REQUIRED_FOR_PAYMENT=true

{
  "name": "Xcerebro 2.0 — Weekly CEO Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * SUN"
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Sunday 6pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AGENT_RUNTIME_URL}}/agents/auto-ceo/invoke",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.AGENT_RUNTIME_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"task\": \"Run the weekly strategic review. Synthesize the past 7 days of business activity (revenue, content performance, sales pipeline, ops). Identify the bottleneck. Recommend 1-3 priorities for the operator's week ahead. Format for Slack readability with section headers. Total under 400 words.\",\n  \"context\": {\n    \"week_ending\": \"{{$now.toISOString().slice(0,10)}}\",\n    \"timezone\": \"{{$env.TIMEZONE || 'America/Chicago'}}\"\n  },\n  \"require_approval\": false\n}",
        "options": {
          "timeout": 180000
        },
        "method": "POST"
      },
      "id": "call-ceo",
      "name": "Invoke CEO Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "channel": "={{$env.SLACK_NOTIFICATIONS_CHANNEL_ID}}",
        "text": "=📊 *Weekly CEO Summary — {{$now.format('MMM D, YYYY')}}*\n\n{{$json.result}}\n\n_Generated by auto-ceo · Xcerebro 2.0_",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "id": "post-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Sunday 6pm Trigger": {
      "main": [[{ "node": "Invoke CEO Agent", "type": "main", "index": 0 }]]
    },
    "Invoke CEO Agent": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Chicago",
    "saveDataErrorExecution": "all"
  },
  "tags": [{ "name": "xcerebro" }, { "name": "weekly" }, { "name": "leadership" }],
  "pinData": {},
  "versionId": "1.0.0"
}
